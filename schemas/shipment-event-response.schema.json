{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipment-event-response.schema.json",
  "title": "ShipmentEventResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountability_state",
    "follow_up_candidate",
    "supervisor_escalation_candidate",
    "proactive_notification_draft"
  ],
  "properties": {
    "accountability_state": {"$ref": "accountability-state.schema.json"},
    "follow_up_candidate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["task_type", "existing_ticket_id", "priority", "summary"],
      "properties": {
        "task_type": {"const": "WAREHOUSE_FOLLOW_UP"},
        "existing_ticket_id": {"type": ["string", "null"]},
        "priority": {"enum": ["NORMAL", "HIGH"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "supervisor_escalation_candidate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["escalation_type", "priority", "summary"],
      "properties": {
        "escalation_type": {"const": "PROMISE_OVERDUE"},
        "priority": {"const": "HIGH"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "proactive_notification_draft": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "text",
        "commits_next_update_at",
        "requires_human_approval",
        "channel"
      ],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "commits_next_update_at": {"type": "string", "format": "date-time"},
        "requires_human_approval": {"const": true},
        "channel": {"const": "ORIGINAL_CHAT"}
      }
    }
  }
}
