{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emotion-state.schema.json",
  "title": "EmotionState",
  "type": "object",
  "additionalProperties": false,
  "required": ["current_label", "trend", "cause", "communication_guidance", "source_evidence_ids", "confidence"],
  "properties": {
    "current_label": {"enum": ["CALM", "ANXIOUS", "FRUSTRATED", "CONFUSED", "URGENT", "UNKNOWN"]},
    "trend": {"enum": ["STABLE", "IMPROVING", "WORSENING", "UNKNOWN"]},
    "cause": {"type": "string", "minLength": 1},
    "communication_guidance": {"type": "string", "minLength": 1},
    "source_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_scoring_allowed": {"const": false}
  }
}
