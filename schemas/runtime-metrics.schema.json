{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-metrics.schema.json",
  "title": "RuntimeMetrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["measurement_status", "input_tokens", "output_tokens", "inference_latency_ms", "rule_substitution_count"],
  "properties": {
    "measurement_status": {"enum": ["MEASURED", "NOT_MEASURED"]},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "inference_latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "rule_substitution_count": {"type": ["integer", "null"], "minimum": 0}
  }
}
