{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk-case.schema.json",
  "title": "RiskCase",
  "type": "object",
  "required": ["case_id", "consumer", "product", "risk", "emotion", "effort", "promise", "resolution", "next_best_action"],
  "properties": {
    "case_id": {"type": "string"},
