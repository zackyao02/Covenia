    "product": {"type": "string"},
    "risk": {"type": "object"},
    "emotion": {"type": "object"},
    "effort": {"type": "object"},
    "promise": {"type": "object"},
    "resolution": {"type": "object"},
    "next_best_action": {"type": "object"}
  }
}
