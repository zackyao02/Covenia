  "model_runs": [],
  "not_completed": [],
  "risks": [
    {
      "id": "R18-CASE-SCOPE",
      "description": "Old BATCH-03 docs/semantic-lock describe endpoint-scoped request keys, while the current plan/package and explicit user task authorize case scope. This implementation follows the current explicit authorization and includes operation in the digest.",
      "mitigation": "Consumers use different keys across operations. Shared docs remain owner-controlled. The independent verifier must use the supplied current BATCH-18 package."
    },
    {
      "id": "R18-NULL-DTO",
      "description": "The f507e37 schema accepts terminal next_update_by=null while the frozen shared DTO remains non-nullable.",
      "mitigation": "Storage-local schema-compatible subclasses preserve terminal null on snapshot/complete response round trips. Terminal-producing services must use schema-compatible construction until the domain owner aligns its DTO."
    },
    {
      "id": "R18-CALLBACK",
      "description": "Storage serializes writes and ordering, but service callbacks own approval legality, rules and logistics transitions.",
      "mitigation": "Validate effective requests and response payloads and revalidate current facts inside the callback; callbacks must avoid external side effects."
    },
    {
      "id": "R18-MAINTENANCE",
      "description": "Restore rewinds local history to a backup, so active application writers must be stopped for maintenance.",
      "mitigation": "Existing targets require an explicit new before-restore backup path; restore is one transaction and never deletes/replaces DB/WAL files."
    },
    {
      "id": "R18-PERMISSION",
      "description": "Normal-sandbox ruff DLL startup failed (-1073741502) and Git cannot inspect six residual pip directories.",
      "mitigation": "Same ruff command succeeded after regular require_escalated approval. Permission warnings and all directories are preserved; no ACL/global-temp cleanup and no whole-worktree clean claim."
    },
    {
      "id": "R18-GATE",
      "description": "Implementation evidence is not independent acceptance or an integration receipt.",
      "mitigation": "Hand off both commits to an independent verifier; this task does not start dependent work."
    }
  ],
  "rollback": {
    "code": "Revert only 3712a170969998e32b56d33e3d59c7b21a04f19d in a separately authorized context; revert the report-only delivery commit separately if needed. Preserve unrelated work and the accepted f507e37 schema baseline.",
    "runtime_state": "No production DB was touched. Test DBs remain in run/b18/t1 and t2. Real runtime DBs require storage.admin backup before any migration/recovery; use explicit absolute DB/backup paths and a fresh --before-restore path for existing restore targets. Do not delete DBs to resolve conflicts."
  },
  "handoff": {
    "interfaces": [
      "SQLiteLedgerRepository.load/save (frozen LedgerRepository port)",
      "SQLiteLedgerRepository.execute (case-scoped atomic callback transaction)",
      "load_version/audit_history/event_history local methods",
      "storage.admin backup/restore local CLI"
    ],
