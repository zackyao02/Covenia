# Non-secret local configuration inventory. Export these names in the host
# environment; the bootstrap deliberately does not auto-load a .env file.
COVENIA_MODEL_ENDPOINT=http://127.0.0.1:8001
COVENIA_IMAGE_ROOT=./data/images
COVENIA_SQLITE_PATH=./runtime/covenia.sqlite3
COVENIA_ALLOWED_ORIGIN=http://localhost:5173
COVENIA_DEMO_CLOCK=system
COVENIA_CACHE_MODE=disabled
COVENIA_PII_SAFETY_CHECKS_ENABLED=true
